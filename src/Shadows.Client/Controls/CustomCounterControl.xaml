<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Shadows.Client.Controls.CustomCounterControl">
    <Grid Margin="0,5,0,5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="18" />
            <RowDefinition Height="5" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Text="-" WidthRequest="30" Style="{StaticResource standardButton}" Clicked="btnMinus_Clicked" />
        <Label Grid.Row="0" Grid.Column="1" x:Name="lblCaption" Margin="6,0,6,0" HorizontalOptions="Start" HorizontalTextAlignment="Start" FontAttributes="Bold" />
        <Label Grid.Row="0" Grid.Column="2" x:Name="lblValue" Margin="6,0,6,0" HorizontalOptions="End" HorizontalTextAlignment="End" FontAttributes="Bold" />
        <Button Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Text="+" WidthRequest="30" Style="{StaticResource standardButton}" Clicked="btnPlus_Clicked" />
        
        <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="pbValue" Margin="6,0,6,0" />

    </Grid>
</ContentView>
