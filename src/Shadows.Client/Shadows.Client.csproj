<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android36.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>Shadows.Client</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
		<ApplicationTitle>Stíny nad pevninou</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.kopec.shadows.client</ApplicationId>
		<ApplicationIdGuid>9D89AA95-42B7-4827-A543-DBED868BF1C8</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.4.2</ApplicationDisplayVersion>
		<ApplicationVersion>29</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<GenerateAppInstallerFile>False</GenerateAppInstallerFile>
		<AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
		<AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
		<GenerateTestArtifacts>True</GenerateTestArtifacts>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
		<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
		<PackageCertificateThumbprint>433DCD3A648F3B4C0385669C80A793D5510B308B</PackageCertificateThumbprint>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="Black" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Images\logo.png" Color="Black" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="14.0.1" />
		<PackageReference Include="Plugin.LocalNotification" Version="13.0.0" />
		<PackageReference Include="Plugin.MauiMTAdmob" Version="2.2.0" />
		<PackageReference Include="System.ServiceModel.Http" Version="10.0.652802" />
		<PackageReference Include="System.ServiceModel.Primitives" Version="10.0.652802" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.41" />
		<PackageReference Update="Microsoft.Maui.Controls.Compatibility" Version="8.0.82" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Shadows.Api\Shadows.Api.csproj" />
		<ProjectReference Include="..\Shadows.Data\Shadows.Data.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Popups\CustomCounterControlAdd.xaml.cs">
	    <DependentUpon>CustomCounterControlAdd.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>
	
	<PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Release'">
		<AndroidKeyStore>True</AndroidKeyStore>
		<AndroidSigningKeyStore>..\shadows.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>Key</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>shadowspwd</AndroidSigningKeyPass>
		<AndroidSigningStorePass>shadowspwd</AndroidSigningStorePass>
	</PropertyGroup>
	
</Project>
