<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="GreenColor">LightGreen</Color>
    <Color x:Key="RedColor">Red</Color>
    
    <Color x:Key="BackgroundColor">Black</Color>

    <Color x:Key="LabelColor">#E5E5E5</Color>
    
    <Color x:Key="InputColor">#E5E5E5</Color>
    <Color x:Key="InputBackgound">#404040</Color>

    <Color x:Key="ProgressBackgound">#303030</Color>

    <Color x:Key="ButtonColor">#212121</Color>
    <Color x:Key="ButtonBackgound">#E5E5E5</Color>
    
    <Color x:Key="BorderColor">LightGray</Color>
    <Color x:Key="DelimiterColor">#404040</Color>

    <Color x:Key="TabBarBackground">#404040</Color>
