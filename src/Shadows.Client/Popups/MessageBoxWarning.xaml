<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Shadows.Client.Popups.MessageBoxWarning"
               BackgroundColor="Transparent"
               Padding="0">
    <VerticalStackLayout>
        <Border Style="{StaticResource borderPopupRed}">
            <VerticalStackLayout>
                <Label Text="Upozornění" x:Name="lblCaption" Style="{StaticResource pageCaption}"></Label>
                <Label Text="Text" x:Name="lblText" Style="{StaticResource centerLabel}"></Label>
                <HorizontalStackLayout HorizontalOptions="Center">
                    <Button Text="Zavřít" Style="{StaticResource popupButton}" Clicked="btnClose_Clicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</toolkit:Popup>
